{
  "lineWidth": 100,
  "indentWidth": 2,
  "useTabs": false,
  "typescript": {
    "quoteStyle": "preferDouble",
    "semiColons": "always"
  },
  "json": {},
  "markdown": {
    "lineWidth": 0
  },
  "toml": {},
  "includes": ["**/*.{ts,tsx,js,jsx,json,md,toml,yaml,yml}"],
  "excludes": [
    "**/node_modules",
    "**/target",
    "**/dist",
    "**/build",
    "**/coverage",
    "Cargo.lock",
    "pnpm-lock.yaml"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.91.6.wasm",
    "https://plugins.dprint.dev/json-0.19.3.wasm",
    "https://plugins.dprint.dev/markdown-0.17.8.wasm",
    "https://plugins.dprint.dev/toml-0.6.2.wasm"
  ]
}
