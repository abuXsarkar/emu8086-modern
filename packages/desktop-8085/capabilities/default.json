{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Cross-platform capability set for the modern8085 main webview. Minimal: open external URLs for the Help menu. No filesystem, no shell.execute.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/abuXsarkar/modern8086/**" },
        { "url": "https://abuxsarkar.github.io/modern8086/**" },
        { "url": "https://*.workers.dev/**" },
        { "url": "https://modern8086.com/**" }
      ]
    }
  ]
}
