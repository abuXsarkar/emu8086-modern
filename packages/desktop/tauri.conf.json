{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "modern8086",
  "version": "1.1.2",
  "identifier": "com.cyberdude.modern8086",
  "build": {
    "beforeDevCommand": "pnpm --filter @modern8086/web dev",
    "beforeBuildCommand": "pnpm --filter @modern8086/web build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "modern8086",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "Abu Sufian Sarkar",
    "homepage": "https://github.com/abuXsarkar/modern8086",
    "copyright": "© Abu Sufian Sarkar. MIT-licensed.",
    "license": "MIT",
    "shortDescription": "8086 emulator and assembly IDE.",
    "longDescription": "A modern, open-source 8086 microprocessor emulator and assembly IDE for students. Edit and step through 8086 assembly with a time-travel debugger, drive eight live virtual peripherals, share programs via URL fragments, and run live classroom sessions. Built on a Rust + WebAssembly core; packaged here as a native desktop application.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "exceptionDomain": null
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/abuXsarkar/modern8086/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}
