{
  "name": "@modern8086/cli",
  "version": "1.1.2",
  "description": "Node-shim distribution of the modern8086 CLI. Downloads the native Rust binary for your platform on install.",
  "license": "MIT",
  "author": "Abu Sufian Sarkar <abu@cyberdude.com>",
  "homepage": "https://github.com/abuXsarkar/modern8086",
