{
  "name": "@modern8086/classroom-server",
  "version": "1.1.2",
  "private": true,
  "description": "Classroom-mode WebSocket relay (Node + ws). Runtime-agnostic Room state machine paired with a Node entry point.",
  "license": "MIT",
  "author": "Abu Sufian Sarkar <abu@cyberdude.com>",
  "type": "module",
  "main": "dist/src/node.js",
  "exports": {
    ".": {
      "types": "./dist/src/node.d.ts",
      "import": "./dist/src/node.js",
      "default": "./dist/src/node.js"
    },
    "./room": {
      "types": "./dist/src/room.d.ts",
      "import": "./dist/src/room.js",
      "default": "./dist/src/room.js"
    },
    "./host-token": {
      "types": "./dist/src/host-token.d.ts",
      "import": "./dist/src/host-token.js",
      "default": "./dist/src/host-token.js"
    },
    "./wordlist": {
      "types": "./dist/src/wordlist.d.ts",
      "import": "./dist/src/wordlist.js",
      "default": "./dist/src/wordlist.js"
    },
    "./protocol-helpers": {
      "types": "./dist/src/protocol-helpers.d.ts",
      "import": "./dist/src/protocol-helpers.js",
      "default": "./dist/src/protocol-helpers.js"
    }
  },
  "bin": {
    "modern8086-classroom-server": "dist/src/node.js",
    "modern8086-classroom-gen-secret": "dist/src/gen-secret.js"
  },
  "scripts": {
    "build": "tsc -b",
    "prepare": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "pnpm build && node dist/src/node.js",
    "test": "vitest run",
    "gen-secret": "pnpm build && node dist/src/gen-secret.js"
  },
  "dependencies": {
    "@modern8086/classroom-protocol": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.0",
    "vitest": "^2.1.1"
  }
}
