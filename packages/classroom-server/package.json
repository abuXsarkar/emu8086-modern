{
  "name": "@emu8086/classroom-server",
  "version": "0.0.0",
  "private": true,
  "description": "Classroom-mode WebSocket relay (Node + ws). Runtime-agnostic Room state machine paired with a Node entry point.",
  "license": "MIT",
  "author": "Abu Sufian Sarkar <abu@cyberdude.com>",
  "type": "module",
  "main": "src/node.ts",
  "bin": {
    "emu8086-classroom-server": "dist/src/node.js",
    "emu8086-classroom-gen-secret": "dist/src/gen-secret.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "pnpm build && node dist/src/node.js",
    "test": "vitest run",
    "gen-secret": "pnpm build && node dist/src/gen-secret.js"
  },
  "dependencies": {
    "@emu8086/classroom-protocol": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.0",
    "vitest": "^2.1.1"
  }
}
