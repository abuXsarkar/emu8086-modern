{
  "name": "@modern8086/plugin-sdk",
  "version": "1.1.1",
  "private": true,
  "description": "Plugin SDK for modern8086. Author a device that observes port writes and renders inside the IDE.",
  "license": "MIT",
  "author": "Abu Sufian Sarkar <abu@cyberdude.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -b",
    "prepare": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "react": "^18.3.1",
    "typescript": "^5.5.0",
    "vitest": "^2.1.1"
  }
}
