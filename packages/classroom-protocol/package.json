{
  "name": "@emu8086/classroom-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript types for the classroom-mode WebSocket protocol.",
  "license": "MIT",
  "author": "Abu Sufian Sarkar <abu@cyberdude.com>",
  "type": "module",
  "main": "dist/index.js",
