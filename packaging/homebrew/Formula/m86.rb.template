# Homebrew formula for the modern8086 CLI (`m86`).
#
# Lives in the maintainer's Homebrew tap repo
# (`abuXsarkar/homebrew-modern8086`, file path `Formula/m86.rb`).
# This in-repo copy is a template — `packaging/scripts/generate-distribution-manifests.sh`
# fills in the version and per-platform SHA-256 sums from the just-built
# release artifacts and emits a copy-pasteable `m86.rb` in
# `target/packaging/`.
#
# After the script runs, drop the generated file into the tap repo's
# `Formula/` directory, commit, push. Users then install with:
#
#   brew tap abuxsarkar/modern8086
#   brew install m86
#
# Subsequent versions: re-run the generator after each release tag.
class M86 < Formula
  desc "Headless 8086 runner and autograder"
  homepage "https://modern8086.com"
  version "{{VERSION}}"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/abuXsarkar/modern8086/releases/download/v#{version}/m86-macos-aarch64.tar.gz"
      sha256 "{{SHA256_MACOS_AARCH64}}"
    end
    on_intel do
      url "https://github.com/abuXsarkar/modern8086/releases/download/v#{version}/m86-macos-x86_64.tar.gz"
      sha256 "{{SHA256_MACOS_X86_64}}"
    end
  end

  on_linux do
    on_intel do
      url "https://github.com/abuXsarkar/modern8086/releases/download/v#{version}/m86-linux-x86_64.tar.gz"
      sha256 "{{SHA256_LINUX_X86_64}}"
    end
  end

  def install
    bin.install "m86"
  end

  test do
    assert_match(/modern8086-core/, shell_output("#{bin}/m86 version"))
  end
end
